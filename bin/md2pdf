#!/usr/bin/env python3
"""md2pdf — Markdown 转 PDF，并把远程图片下载到本地嵌入。

用法:
    ./bin/md2pdf input.md [-o output.pdf] [--images DIR] [--keep-html]

依赖:
    pip install markdown requests   # Python 依赖
    系统需有 Chrome/Chromium       # 用于矢量 PDF 输出 (headless print-to-pdf)

流程:
  1. 解析 Markdown 中的图片引用（含 [![缩略图](…)](原图…) 链接式图片，优先下载原图）
  2. 图片保存到 <stem>_images/，MD 中的 URL 改写为本地相对路径
  3. Markdown → HTML（中文排版样式，图片带题注）
  4. Chrome headless 打印为矢量 PDF（文字可选中，标题写入 PDF 元数据）
"""

import argparse
import re
import shutil
import subprocess
import sys
import urllib.parse
from pathlib import Path

try:
    import markdown
    import requests
except ImportError as exc:
    sys.exit(f"缺少 Python 依赖: {exc}\n安装: pip install markdown requests")

CHROME_CANDIDATES = [
    "google-chrome-stable", "google-chrome", "chromium", "chromium-browser",
]
CT_EXT = {
    "image/png": ".png", "image/jpeg": ".jpg", "image/gif": ".gif",
    "image/webp": ".webp", "image/svg+xml": ".svg", "image/avif": ".avif",
}
HEADERS = {
    "User-Agent": ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                   "(KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"),
    "Referer": "https://linux.do/",
}

# [![alt](thumb)](original "title") —— 链接式图片，原图在链接目标上（允许中间有换行）
RE_LINKED_IMG = re.compile(
    r'\[\s*!\[([^\]]*)\]\(\s*([^)\s]+)\s*\)\s*\]'
    r'\(\s*([^)\s]+)(?:\s+"([^"]*)")?\s*\)')
# ![alt](url "title") —— 普通图片
RE_IMG = re.compile(r'!\[([^\]]*)\]\(\s*([^)\s]+)(?:\s+"([^"]*)")?\s*\)')
# 空锚点，如 [](#p-24300733-h-1)
RE_EMPTY_ANCHOR = re.compile(r'\[\]\(#[^)]*\)')
# 生成 HTML 中的独立段落图片 → figure + figcaption
RE_P_IMG = re.compile(r'<p>(<img\b[^>]*>)\s*</p>')


def find_chrome() -> str:
    for name in CHROME_CANDIDATES:
        path = shutil.which(name)
        if path:
            return path
    sys.exit("错误: 找不到 Chrome/Chromium，请先安装 google-chrome 或 chromium")


class ImageStore:
    """按 URL 去重下载图片，返回本地文件名（相对 images 目录）。"""

    def __init__(self, img_dir: Path):
        self.img_dir = img_dir
        self.img_dir.mkdir(parents=True, exist_ok=True)
        self.cache: dict[str, str] = {}   # url -> local filename
        self.failures: list[str] = []
        self.counter = 0

    def get(self, url: str) -> str | None:
        if url in self.cache:
            return self.cache[url]
        if not url.startswith(("http://", "https://")):
            return None  # 本地路径等，原样保留
        ext = Path(urllib.parse.urlparse(url).path).suffix.lower()
        if ext not in CT_EXT.values():
            ext = ""  # 待响应头确定
        for attempt in range(3):
            try:
                resp = requests.get(url, headers=HEADERS, timeout=30)
                resp.raise_for_status()
                ctype = resp.headers.get("Content-Type", "").split(";")[0].strip().lower()
                if ctype in CT_EXT and not ext:
                    ext = CT_EXT[ctype]
                if not ext:
                    ext = ".png"
                if resp.content[:4] == b"<svg":
                    ext = ".svg"
                self.counter += 1
                name = f"img-{self.counter:02d}{ext}"
                (self.img_dir / name).write_bytes(resp.content)
                self.cache[url] = name
                size_kb = len(resp.content) / 1024
                print(f"  [ok] {name}  ({size_kb:.0f} KB)  <- {url[:80]}")
                return name
            except requests.RequestException as exc:
                if attempt == 2:
                    self.failures.append(url)
                    print(f"  [失败] {url}  -> {exc}")
        return None


def localize_images(text: str, store: ImageStore) -> str:
    """把 MD 里的远程图片替换为本地相对路径（相对于 images 目录）。"""

    def sub_linked(m: re.Match) -> str:
        alt, _thumb, orig, title = m.group(1), m.group(2), m.group(3), m.group(4)
        name = store.get(orig)
        if name is None:
            return m.group(0)
        label = title or alt
        return f'![{label}]({name}{" " + chr(34) + label + chr(34) if title else ""})'

    def sub_plain(m: re.Match) -> str:
        alt, url, title = m.group(1), m.group(2), m.group(3)
        name = store.get(url)
        if name is None:
            return m.group(0)
        label = title or alt
        return f'![{label}]({name}{" " + chr(34) + label + chr(34) if title else ""})'

    text = RE_LINKED_IMG.sub(sub_linked, text)
    text = RE_IMG.sub(sub_plain, text)
    return text


def build_html(title: str, meta: str, body_html: str) -> str:
    # 独立成段的图片 → <figure> + 题注（取 title 属性）
    def to_figure(m: re.Match) -> str:
        img = m.group(1)
        t = re.search(r'title="([^"]*)"', img)
        cap = f'<figcaption>{t.group(1)}</figcaption>' if t and t.group(1) else ""
        return f"<figure>{img}{cap}</figure>"

    body_html = RE_P_IMG.sub(to_figure, body_html)
    meta_html = f'<div class="meta">{meta}</div>' if meta else ""
    return f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{title}</title>
<style>
  @page {{ size: A4; margin: 16mm 15mm 18mm 15mm; }}
  html, body {{ margin: 0; padding: 0; background: #ffffff; }}
  body {{
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    font-size: 10.5pt; line-height: 1.8; color: #1f2328;
    line-break: strict; word-break: normal;
  }}
  h1 {{ font-size: 19pt; line-height: 1.45; margin: 0 0 .35em; }}
  .meta {{ color: #6b7280; font-size: 9pt; margin-bottom: 1.6em;
          padding-bottom: 1em; border-bottom: 1px solid #e5e7eb; }}
  h2 {{ font-size: 14.5pt; margin: 1.9em 0 .6em; padding-bottom: .25em;
       border-bottom: 1px solid #e5e7eb; break-after: avoid; }}
  h3 {{ font-size: 12pt; margin: 1.4em 0 .5em; break-after: avoid; }}
  p {{ margin: .65em 0; text-align: justify; }}
  strong {{ color: #111827; }}
  blockquote {{ margin: 1em 0; padding: .55em 1em; border-left: 3px solid #d1d5db;
               background: #f8f9fa; color: #4b5563; }}
  blockquote p {{ margin: .3em 0; }}
  code {{ font-family: "JetBrains Mono", "Fira Code", Consolas, monospace;
         background: #f3f4f6; padding: .12em .35em; border-radius: 3px;
         font-size: .88em; }}
  pre {{ background: #f6f8fa; border: 1px solid #e5e7eb; border-radius: 5px;
        padding: .8em 1em; overflow-wrap: break-word; white-space: pre-wrap; }}
  pre code {{ background: none; padding: 0; }}
  /* inline-block 使 figure 成为不可分割的原子盒，避免 Chromium 打印时图与图注被拆到两页 */
  figure {{ display: inline-block; width: 100%; vertical-align: top;
           margin: 1.3em 0; text-align: center;
           break-inside: avoid; page-break-inside: avoid; }}
  figure img {{ max-width: 100%; }}
  figcaption {{ font-size: 8.5pt; color: #6b7280; margin-top: .5em; }}
  img {{ max-width: 100%; }}
  hr {{ border: none; border-top: 1px solid #e5e7eb; margin: 1.8em auto; width: 38%; }}
  ul, ol {{ padding-left: 1.6em; }}
  li {{ margin: .3em 0; }}
  a {{ color: #0366d6; text-decoration: none; }}
</style>
</head>
<body>
<h1>{title}</h1>
{meta_html}
{body_html}
</body>
</html>
"""


def page_count(pdf: Path) -> int:
    """尽力从 PDF 字节中数页数（chrome 输出通常可见 /Count 或 /Type /Page）。"""
    data = pdf.read_bytes()
    counts = [int(n) for n in re.findall(rb"/Count\s+(\d+)", data)]
    if counts:
        return max(counts)
    pages = re.findall(rb"/Type\s*/Page\b(?!s)", data)
    return len(pages)


def main() -> None:
    ap = argparse.ArgumentParser(description="Markdown 转 PDF（图片本地化）")
    ap.add_argument("input", help="输入 .md 文件")
    ap.add_argument("-o", "--output", help="输出 PDF 路径（默认与输入同目录同名 .pdf）")
    ap.add_argument("--images", help="图片目录（默认 <输入名>_images/）")
    ap.add_argument("--keep-html", action="store_true", help="保留中间 HTML")
    args = ap.parse_args()

    src = Path(args.input).expanduser().resolve()
    if not src.is_file():
        sys.exit(f"错误: 文件不存在: {src}")

    stem = src.stem
    out_pdf = Path(args.output).expanduser() if args.output else src.with_suffix(".pdf")
    img_dir = Path(args.images).expanduser() if args.images else src.parent / f"{stem}_images"

    # 文件名 "标题 - 版块 - 站点" → 文章标题 + 来源行
    parts = [p.strip() for p in stem.split(" - ")] if " - " in stem else [stem]
    title = parts[0]
    meta = "来源: " + " · ".join(parts[1:]) if len(parts) > 1 else ""

    text = src.read_text(encoding="utf-8")
    text = text.replace("\r\n", "\n")
    text = RE_EMPTY_ANCHOR.sub("", text)
    # 论坛导出常见的转义残留：\*\*强调\*\* 还原为加粗
    text = text.replace("\\*\\*", "**")

    print(f"[1/3] 下载图片 -> {img_dir}/")
    store = ImageStore(img_dir)
    text = localize_images(text, store)

    print(f"[2/3] 渲染 HTML")
    body = markdown.markdown(text, extensions=["extra", "sane_lists"])
    html = build_html(title, meta, body)
    html_path = img_dir / "index.html"
    html_path.write_text(html, encoding="utf-8")

    print(f"[3/3] Chrome 生成 PDF")
    chrome = find_chrome()
    cmd = [
        chrome, "--headless", "--disable-gpu", "--hide-scrollbars",
        "--no-pdf-header-footer", "--force-color-profile=srgb",
        "--virtual-time-budget=20000",
        f"--print-to-pdf={out_pdf}",
        html_path.resolve().as_uri(),
    ]
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    if not out_pdf.is_file() or out_pdf.stat().st_size < 1024:
        sys.exit(f"错误: PDF 生成失败\n{proc.stderr[-2000:]}")

    if not args.keep_html:
        html_path.unlink(missing_ok=True)

    print(f"\n完成: {out_pdf}  ({out_pdf.stat().st_size / 1024:.0f} KB, "
          f"约 {page_count(out_pdf)} 页)")
    print(f"图片: {len(store.cache)} 张 -> {img_dir}/")
    if store.failures:
        print(f"警告: {len(store.failures)} 张下载失败（PDF 中保留原图链接处已标注）:")
        for u in store.failures:
            print(f"  - {u}")


if __name__ == "__main__":
    main()
